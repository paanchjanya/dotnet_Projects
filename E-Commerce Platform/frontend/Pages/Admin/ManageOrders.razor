@page "/admin/orders"
@attribute [Authorize(Roles = "Admin")]
@inject ApiService ApiService

<div class="fade-in mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 font-outfit fw-bold text-dark mb-1">Manage Store Orders</h1>
            <p class="text-secondary small">Update shipping statuses or review transactions</p>
        </div>
        <a href="/admin/dashboard" class="btn btn-outline-secondary"><span class="bi bi-speedometer2"></span> Back to Dashboard</a>
    </div>

    <!-- Success/Failure Notifications -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <span class="bi bi-check-circle me-1"></span> @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-secondary mt-3">Syncing customer orders...</p>
        </div>
    }
    else if (orders == null || orders.Count == 0)
    {
        <div class="text-center py-5 border rounded-3 bg-white shadow-sm">
            <span class="bi bi-inbox fs-1 text-secondary mb-3 d-inline-block"></span>
            <h3>No orders recorded</h3>
            <p class="text-secondary">Orders will appear here once customers place them.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var order in orders)
            {
                <div class="card shadow-sm border-light bg-white rounded-3 overflow-hidden">
                    <!-- Order Main Info Banner -->
                    <div class="card-header bg-light border-bottom-0 py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-4 flex-wrap">
                            <div>
                                <span class="text-secondary small d-block">ORDER ID</span>
                                <span class="fw-bold text-dark">#@order.Id</span>
                            </div>
                            <div>
                                <span class="text-secondary small d-block">CUSTOMER</span>
                                <span class="fw-semibold text-dark">@order.CustomerName</span>
                            </div>
                            <div>
                                <span class="text-secondary small d-block">DATE PLACE</span>
                                <span class="fw-semibold text-dark">@order.OrderDate.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</span>
                            </div>
                            <div>
                                <span class="text-secondary small d-block">SHIPPING ADDRESS</span>
                                <span class="fw-semibold text-dark">@order.ShippingAddress</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-4">
                            <div>
                                <span class="text-secondary small d-block text-end">TOTAL REVENUE</span>
                                <span class="fw-bold text-primary font-outfit fs-5">$@order.TotalAmount.ToString("F2")</span>
                            </div>
                            
                            <!-- Status Selector Dropdown -->
                            <div>
                                <span class="text-secondary small d-block mb-1">SHIPPING STATUS</span>
                                <select class="form-select form-select-sm fw-semibold" 
                                        style="width: 130px; background-color: #fff;"
                                        value="@order.Status"
                                        @onchange="(e) => ChangeStatus(order.Id, e.Value?.ToString())">
                                    <option value="Pending">Pending</option>
                                    <option value="Shipped">Shipped</option>
                                    <option value="Delivered">Delivered</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Items breakout -->
                    <div class="card-body p-4 bg-white">
                        <div class="d-flex flex-column gap-3">
                            <h6 class="fw-bold text-secondary border-bottom border-light pb-2 mb-1">ORDER ITEMS</h6>
                            @foreach (var item in order.Items)
                            {
                                <div class="d-flex align-items-center justify-content-between py-1">
                                    <div class="d-flex align-items-center">
                                        <img src="@GetAbsoluteImageUrl(item.CoverImageUrl)" alt="@item.BookTitle" class="rounded" style="width: 38px; height: 50px; object-fit: cover; margin-right: 0.75rem;" />
                                        <div>
                                            <span class="fw-bold text-dark d-block">@item.BookTitle</span>
                                            <span class="text-secondary small">by @item.BookAuthor</span>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="text-secondary small d-block">Qty: @item.Quantity</span>
                                        <span class="fw-semibold text-dark">$@((item.UnitPrice * item.Quantity).ToString("F2"))</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<OrderResponse>? orders;
    private bool isLoading = true;
    private string statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        orders = await ApiService.GetAllOrdersAsync();
        isLoading = false;
        StateHasChanged();
    }

    private async Task ChangeStatus(int orderId, string? status)
    {
        if (string.IsNullOrEmpty(status)) return;
        
        statusMessage = string.Empty;
        var success = await ApiService.UpdateOrderStatusAsync(orderId, status);
        if (success)
        {
            statusMessage = $"Order #{orderId} status successfully updated to '{status}'.";
            await LoadOrders();
        }
    }

    private string GetAbsoluteImageUrl(string url)
    {
        if (string.IsNullOrEmpty(url))
        {
            return "https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&q=80&w=400";
        }
        if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }
        return $"{ApiService.BaseAddress.TrimEnd('/')}/{url.TrimStart('/')}";
    }
}
