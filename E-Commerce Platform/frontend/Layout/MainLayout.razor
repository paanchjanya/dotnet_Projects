@inherits LayoutComponentBase
@implements IDisposable
@inject CartService CartService
@inject ApiService ApiService
@inject NavigationManager NavigationManager

<div class="min-vh-100 d-flex flex-column">
    <!-- Premium Frosted Navbar -->
    <header class="app-header py-3 shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <!-- Brand Logo -->
            <a href="/" class="brand-title text-decoration-none">
                <span class="bi bi-book-half"></span>
                <span>NovelNook</span>
            </a>

            <!-- Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-4">
                <a href="/" class="text-secondary text-decoration-none fw-semibold hover-link">Home</a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/my-orders" class="text-secondary text-decoration-none fw-semibold hover-link">My Orders</a>
                        @if (context.User.IsInRole("Admin"))
                        {
                            <a href="/admin/dashboard" class="text-danger text-decoration-none fw-semibold hover-link admin-pill">
                                <span class="bi bi-shield-lock me-1"></span>Admin Panel
                            </a>
                        }
                    </Authorized>
                </AuthorizeView>
            </nav>

            <!-- Cart and User Actions -->
            <div class="d-flex align-items-center gap-3">
                <!-- Cart Trigger Button -->
                <a href="/cart" class="position-relative p-2 text-secondary text-decoration-none hover-scale" title="Shopping Cart">
                    <span class="bi bi-bag-fill fs-4 text-dark"></span>
                    @if (cartCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary cart-badge @(bounceBadge ? "cart-badge-bounce" : "")">
                            @cartCount
                        </span>
                    }
                </a>

                <div class="vr mx-1"></div>

                <!-- User Dropdown / Auth Buttons -->
                <AuthorizeView>
                    <Authorized>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="bi bi-person-circle fs-5"></span>
                                <span class="fw-semibold">@context.User.Identity?.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-md border-0" aria-labelledby="userMenu">
                                <li><a class="dropdown-item py-2" href="/my-orders"><span class="bi bi-receipt me-2"></span>My Orders</a></li>
                                @if (context.User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item py-2 text-danger" href="/admin/dashboard"><span class="bi bi-shield-lock me-2"></span>Admin Dashboard</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item py-2 text-secondary" @onclick="HandleLogout"><span class="bi bi-box-arrow-right me-2"></span>Logout</button></li>
                            </ul>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex align-items-center gap-2">
                            <a href="/login" class="btn btn-link text-decoration-none fw-semibold text-secondary">Login</a>
                            <a href="/register" class="btn btn-primary">Sign Up</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- Main Content Body -->
    <main class="flex-grow-1 container my-4">
        @Body
    </main>

    <!-- Premium Footer -->
    <footer class="bg-white border-top py-4 mt-auto text-secondary">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="bi bi-book-half text-primary fs-5"></span>
                <span class="fw-bold text-dark font-outfit">NovelNook Bookstore</span>
            </div>
            <p class="mb-0 text-center small">&copy; 2026 NovelNook. Designed with Blazor WASM & MS SQL Server. All rights reserved.</p>
            <div class="d-flex gap-3">
                <a href="#" class="text-secondary fs-5 hover-color-primary"><span class="bi bi-facebook"></span></a>
                <a href="#" class="text-secondary fs-5 hover-color-primary"><span class="bi bi-twitter"></span></a>
                <a href="#" class="text-secondary fs-5 hover-color-primary"><span class="bi bi-instagram"></span></a>
            </div>
        </div>
    </footer>
</div>

@code {
    private int cartCount = 0;
    private bool bounceBadge = false;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnCartChanged += HandleCartChanged;
        await UpdateCartCount();
    }

    private async void HandleCartChanged()
    {
        await UpdateCartCount();
        bounceBadge = true;
        StateHasChanged();
        await Task.Delay(300);
        bounceBadge = false;
        StateHasChanged();
    }

    private async Task UpdateCartCount()
    {
        cartCount = await CartService.GetTotalCountAsync();
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        await ApiService.LogoutAsync();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= HandleCartChanged;
    }
}

<style>
    .hover-link {
        transition: var(--transition-fast);
        border-bottom: 2px solid transparent;
        padding-bottom: 4px;
    }
    .hover-link:hover {
        color: var(--color-primary) !important;
        border-bottom-color: var(--color-primary);
    }
    .hover-scale {
        transition: var(--transition-fast);
        display: inline-block;
    }
    .hover-scale:hover {
        transform: scale(1.1);
    }
    .hover-color-primary:hover {
        color: var(--color-primary) !important;
    }
    .font-outfit {
        font-family: 'Outfit', sans-serif;
    }
    .admin-pill {
        background-color: #fef2f2;
        border: 1px solid #fee2e2;
        color: #ef4444 !important;
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius-full);
    }
    .admin-pill:hover {
        background-color: #fee2e2;
        border-color: #fca5a5;
    }
    /* Simple bootstrap styles overrides if needed */
    .dropdown-menu {
        border-radius: var(--radius-md) !important;
        padding: 0.5rem !important;
    }
    .dropdown-item {
        border-radius: var(--radius-sm) !important;
    }
    .dropdown-item:hover {
        background-color: var(--bg-primary) !important;
        color: var(--color-primary) !important;
    }
</style>
