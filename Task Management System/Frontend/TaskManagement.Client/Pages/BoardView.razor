@page "/board/{BoardId:guid}"
@attribute [Authorize]
@inject BoardService BoardSvc
@inject AuthStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@(_board?.Name ?? "Kanban Board") - TaskFlow</PageTitle>

@if (_board == null)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 70vh; color: var(--text-main);">
        <h3>Loading board details...</h3>
    </div>
}
else
{
    <div class="board-container">
        <!-- Toolbar -->
        <div class="board-toolbar">
            <div>
                <h2 style="margin: 0 0 0.25rem 0; font-size: 1.5rem; font-weight: 700; color: var(--primary);">@_board.Name</h2>
                <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">@_board.Description</p>
            </div>

            <!-- Filters & Buttons -->
            <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                <!-- Search Input -->
                <input class="form-input" style="width: 200px; padding: 0.4rem 0.75rem; font-size: 0.875rem;" placeholder="Search tasks..." @bind="_searchText" @bind:event="oninput" />

                <!-- Add Column Button -->
                <button class="btn-secondary" style="padding: 0.4rem 1rem; font-size: 0.875rem;" @onclick="ToggleAddColumnForm">
                    + Column
                </button>

                <!-- Toggle Activity Sidebar -->
                <button class="btn-secondary" style="padding: 0.4rem 1rem; font-size: 0.875rem;" @onclick="ToggleActivitySidebar">
                    Activity Logs
                </button>

                <!-- Delete Board Button (Admin/Owner only) -->
                <button class="btn-secondary" style="padding: 0.4rem 1rem; font-size: 0.875rem; color: var(--danger); border-color: rgba(239, 68, 68, 0.2);" @onclick="DeleteBoard">
                    Delete Board
                </button>
            </div>
        </div>

        <!-- Add Column Input Box -->
        @if (_showAddColumnForm)
        {
            <div class="glass-panel" style="padding: 1rem; margin-bottom: 1.5rem; display: flex; gap: 1rem; align-items: center; max-width: 400px;">
                <input class="form-input" placeholder="Column name (e.g. Backlog)" @bind="_newColumnName" @onkeyup="HandleColumnKeyup" />
                <button class="btn-premium" style="width: auto; padding: 0.5rem 1rem;" @onclick="CreateColumn">Add</button>
                <button class="btn-secondary" style="padding: 0.5rem 1rem;" @onclick="ToggleAddColumnForm">Cancel</button>
            </div>
        }

        <!-- Kanban Lanes -->
        <div style="display: flex; flex: 1; overflow: hidden; gap: 1.5rem;">
            <!-- Columns Grid -->
            <div class="board-columns-scroll">
                @foreach (var col in _board.Columns.OrderBy(c => c.Position))
                {
                    <div class="glass-panel kanban-column @(col.Id == _activeDragOverColumn ? "task-drag-over" : "")" 
                         @ondragenter="() => HandleDragEnterColumn(col.Id)"
                         @ondragleave="HandleDragLeaveColumn">
                        
                        <!-- Column Header -->
                        <div class="column-header">
                            @if (_editingColumnId == col.Id)
                            {
                                <input class="form-input" style="padding: 0.2rem 0.5rem; font-size: 1rem;" @bind="_editingColumnName" @onblur="() => SaveColumnName(col)" @onkeyup="(e) => HandleColumnEditKeyup(e, col)" />
                            }
                            else
                            {
                                <div class="column-title" @ondblclick="() => StartEditingColumn(col)">
                                    @col.Name
                                    <span class="column-count">@col.Tasks.Count(FilterTasks)</span>
                                </div>
                            }

                            <!-- Column Actions -->
                            <div style="display: flex; gap: 0.25rem;">
                                <button style="background: transparent; border: none; color: var(--text-muted); cursor: pointer;" @onclick="() => StartAddTask(col.Id)" title="Add Task">
                                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg>
                                </button>
                                <button style="background: transparent; border: none; color: var(--danger); opacity: 0.6; cursor: pointer;" @onclick="() => DeleteColumn(col.Id)" title="Delete Column">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Add Task Form inside Column -->
                        @if (_activeAddTaskColumnId == col.Id)
                        {
                            <div class="glass-panel" style="padding: 0.75rem; margin-bottom: 0.75rem; border-color: var(--primary);">
                                <input class="form-input" style="padding: 0.4rem; font-size: 0.9rem; margin-bottom: 0.5rem;" placeholder="Task title..." @bind="_newTaskTitle" @onkeyup="(e) => HandleTaskKeyup(e, col.Id)" />
                                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <button class="btn-secondary" style="padding: 0.25rem 0.75rem; font-size: 0.75rem;" @onclick="CancelAddTask">Cancel</button>
                                    <button class="btn-premium" style="width: auto; padding: 0.25rem 1rem; font-size: 0.75rem;" @onclick="() => CreateTask(col.Id)">Add</button>
                                </div>
                            </div>
                        }

                        <!-- Task Cards List -->
                        <div class="tasks-list" 
                             @ondragover:prevent
                             @ondrop="() => DropTaskOnColumn(col.Id)">
                            
                            @foreach (var task in col.Tasks.Where(FilterTasks).OrderBy(t => t.Position))
                            {
                                <div class="glass-panel task-card" 
                                     draggable="true" 
                                     @ondragstart="() => HandleDragStart(task)"
                                     @ondragover:prevent
                                     @ondragover="() => HandleDragOverCard(task.Id)"
                                     @ondrop:prevent
                                     @ondrop="() => DropTaskOnCard(col.Id, task.Position)"
                                     @onclick="() => ViewTaskDetails(task.Id)"
                                     style="border-color: @(_activeDragOverCard == task.Id ? "var(--primary)" : "var(--border-color)")">
                                    
                                    <div class="task-header">
                                        <span class="task-title">@task.Title</span>
                                        <span class="badge-priority @task.Priority.ToString().ToLower()">
                                            @task.Priority
                                        </span>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(task.Description))
                                    {
                                        <div class="task-desc">@task.Description</div>
                                    }

                                    <div class="task-meta">
                                        <!-- Due Date Badge -->
                                        @if (task.DueDate.HasValue)
                                        {
                                            <span style="display: flex; align-items: center; gap: 0.25rem; color: @(task.DueDate.Value < DateTime.Today ? "var(--danger)" : "var(--text-muted)")">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                @task.DueDate.Value.ToString("MMM dd")
                                            </span>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }

                                        <!-- Attachments / Comments icons -->
                                        <div class="task-icons">
                                            @if (task.Attachments.Any())
                                            {
                                                <span class="meta-icon" title="Attachments">
                                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15.172 7l-6.586 6.586a2 2 0 11-2.828-2.828l6.414-6.414a4 4 0 015.656 5.656l-6.415 6.415a6 6 0 11-8.486-8.486L10.5 10"/></svg>
                                                    @task.Attachments.Count
                                                </span>
                                            }
                                            @if (task.Comments.Any())
                                            {
                                                <span class="meta-icon" title="Comments">
                                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                                                    @task.Comments.Count
                                                </span>
                                            }
                                            
                                            <!-- Assignee Avatar -->
                                            @if (task.AssignedToUser != null)
                                            {
                                                <img src="@task.AssignedToUser.AvatarUrl" class="avatar" title="@task.AssignedToUser.DisplayName" />
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Activity Logs Sidebar -->
            @if (_showActivitySidebar)
            {
                <div class="glass-panel" style="width: 300px; display: flex; flex-direction: column; padding: 1.5rem; max-height: 100%;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
                        <h3 style="margin: 0; font-size: 1.2rem;">Board Activity</h3>
                        <button style="background: transparent; border: none; color: var(--text-muted); cursor: pointer;" @onclick="ToggleActivitySidebar">✕</button>
                    </div>
                    
                    <div style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; font-size: 0.875rem;">
                        @if (_logs == null)
                        {
                            <div>Loading activities...</div>
                        }
                        else if (!_logs.Any())
                        {
                            <div style="color: var(--text-muted); font-style: italic;">No activities logged yet.</div>
                        }
                        else
                        {
                            @foreach (var log in _logs)
                            {
                                <div style="display: flex; gap: 0.5rem; align-items: flex-start; line-height: 1.4;">
                                    <img src="@log.User?.AvatarUrl" class="avatar" style="width: 20px; height: 20px; margin-top: 0.15rem;" />
                                    <div>
                                        <span style="font-weight: 600; color: var(--primary);">@log.User?.DisplayName</span>
                                        <span>@log.Message</span>
                                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">@log.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Detail Modal -->
@if (_selectedTaskId.HasValue)
{
    <TaskDetailModal TaskId="_selectedTaskId.Value" OnClose="CloseTaskDetails" />
}

@code {
    [Parameter] public Guid BoardId { get; set; }

    private ClientBoard? _board;
    private List<ClientActivityLog>? _logs;
    
    private string _searchText = string.Empty;
    
    private bool _showAddColumnForm;
    private string _newColumnName = string.Empty;

    private Guid? _editingColumnId;
    private string _editingColumnName = string.Empty;

    private Guid? _activeAddTaskColumnId;
    private string _newTaskTitle = string.Empty;

    private Guid? _selectedTaskId;
    private bool _showActivitySidebar;

    // Drag-and-drop state
    private ClientTask? _draggedTask;
    private Guid? _activeDragOverColumn;
    private Guid? _activeDragOverCard;

    private Microsoft.AspNetCore.SignalR.Client.HubConnection? _hubConnection;

    protected override async Task OnParametersSetAsync()
    {
        _board = null;
        await LoadBoard();
        await ResetHubConnection();
    }

    private async Task LoadBoard()
    {
        try
        {
            _board = await BoardSvc.GetBoardAsync(BoardId);
            if (_board == null)
            {
                Navigation.NavigateTo("");
            }
            if (_showActivitySidebar)
            {
                await LoadActivityLogs();
            }
            StateHasChanged();
        }
        catch
        {
            Navigation.NavigateTo("");
        }
    }

    private async Task LoadActivityLogs()
    {
        _logs = await BoardSvc.GetActivityLogsAsync(BoardId);
    }

    private async Task ResetHubConnection()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }

        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrEmpty(token)) return;

            token = token.Trim('"');
            var hubUrl = new Uri(new Uri("http://localhost:5204/"), "boardhub").AbsoluteUri;

            _hubConnection = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
                .WithUrl($"{hubUrl}?access_token={token}")
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<Guid>("BoardUpdated", async (id) =>
            {
                if (id == BoardId)
                {
                    await LoadBoard();
                }
            });

            _hubConnection.On<Guid>("BoardDeleted", (id) =>
            {
                if (id == BoardId)
                {
                    Navigation.NavigateTo("");
                }
            });

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("JoinBoard", BoardId.ToString());
        }
        catch
        {
            // Connect failure
        }
    }

    private bool FilterTasks(ClientTask task)
    {
        if (string.IsNullOrEmpty(_searchText)) return true;
        return task.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
               task.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase);
    }

    // Column Management
    private void ToggleAddColumnForm() => _showAddColumnForm = !_showAddColumnForm;

    private async Task CreateColumn()
    {
        if (string.IsNullOrWhiteSpace(_newColumnName)) return;

        var col = await BoardSvc.CreateColumnAsync(BoardId, _newColumnName);
        if (col != null)
        {
            _newColumnName = string.Empty;
            _showAddColumnForm = false;
            await LoadBoard();
        }
    }

    private async Task HandleColumnKeyup(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CreateColumn();
        }
    }

    private void StartEditingColumn(ClientColumn col)
    {
        _editingColumnId = col.Id;
        _editingColumnName = col.Name;
    }

    private async Task SaveColumnName(ClientColumn col)
    {
        if (string.IsNullOrWhiteSpace(_editingColumnName) || _editingColumnName == col.Name)
        {
            _editingColumnId = null;
            return;
        }

        var success = await BoardSvc.UpdateColumnAsync(col.Id, _editingColumnName);
        _editingColumnId = null;
        if (success)
        {
            await LoadBoard();
        }
    }

    private async Task HandleColumnEditKeyup(KeyboardEventArgs e, ClientColumn col)
    {
        if (e.Key == "Enter")
        {
            await SaveColumnName(col);
        }
        else if (e.Key == "Escape")
        {
            _editingColumnId = null;
        }
    }

    private async Task DeleteColumn(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this column and all its tasks?");
        if (confirmed)
        {
            var success = await BoardSvc.DeleteColumnAsync(id);
            if (success)
            {
                await LoadBoard();
            }
        }
    }

    private async Task DeleteBoard()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete this board permanently?");
        if (confirmed)
        {
            var success = await BoardSvc.DeleteBoardAsync(BoardId);
            if (success)
            {
                Navigation.NavigateTo("");
            }
        }
    }

    // Task Creation inside Columns
    private void StartAddTask(Guid columnId)
    {
        _activeAddTaskColumnId = columnId;
        _newTaskTitle = string.Empty;
    }

    private void CancelAddTask() => _activeAddTaskColumnId = null;

    private async Task CreateTask(Guid columnId)
    {
        if (string.IsNullOrWhiteSpace(_newTaskTitle)) return;

        var task = await BoardSvc.CreateTaskAsync(columnId, _newTaskTitle, string.Empty, TaskPriority.Medium, null, null);
        if (task != null)
        {
            _newTaskTitle = string.Empty;
            _activeAddTaskColumnId = null;
            await LoadBoard();
        }
    }

    private async Task HandleTaskKeyup(KeyboardEventArgs e, Guid columnId)
    {
        if (e.Key == "Enter")
        {
            await CreateTask(columnId);
        }
    }

    // Modal Inspection
    private void ViewTaskDetails(Guid id) => _selectedTaskId = id;
    private async Task CloseTaskDetails()
    {
        _selectedTaskId = null;
        await LoadBoard();
    }

    // HTML5 Drag and Drop Handlers
    private void HandleDragStart(ClientTask task)
    {
        _draggedTask = task;
    }

    private void HandleDragEnterColumn(Guid columnId)
    {
        _activeDragOverColumn = columnId;
    }

    private void HandleDragLeaveColumn()
    {
        _activeDragOverColumn = null;
    }

    private void HandleDragOverCard(Guid cardId)
    {
        _activeDragOverCard = cardId;
    }

    private async Task DropTaskOnColumn(Guid columnId)
    {
        _activeDragOverColumn = null;
        _activeDragOverCard = null;

        if (_draggedTask == null) return;
        
        // If dropping into column container (but not on a card), place at bottom
        if (_draggedTask.ColumnId == columnId)
        {
            // Moving within same column at the end
            var column = _board!.Columns.First(c => c.Id == columnId);
            await DropTaskOnCard(columnId, column.Tasks.Count);
        }
        else
        {
            // Moving to new column at the bottom
            var column = _board!.Columns.First(c => c.Id == columnId);
            await DropTaskOnCard(columnId, column.Tasks.Count);
        }
    }

    private async Task DropTaskOnCard(Guid targetColumnId, int targetPosition)
    {
        _activeDragOverColumn = null;
        _activeDragOverCard = null;

        if (_draggedTask == null) return;

        var taskId = _draggedTask.Id;
        _draggedTask = null;

        // Call Service to update backend positions and trigger SignalR sync
        await BoardSvc.MoveTaskAsync(taskId, targetColumnId, targetPosition);
        await LoadBoard(); // Locally refresh just in case
    }

    // Sidebars
    private async Task ToggleActivitySidebar()
    {
        _showActivitySidebar = !_showActivitySidebar;
        if (_showActivitySidebar)
        {
            await LoadActivityLogs();
        }
    }

    public void Dispose()
    {
        if (_hubConnection != null)
        {
            _ = _hubConnection.InvokeAsync("LeaveBoard", BoardId.ToString());
            _ = _hubConnection.DisposeAsync();
        }
    }
}
