<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div style="padding: 2rem; text-align: center; color: var(--text-main);">
                            <h1>Access Denied</h1>
                            <p>You do not have permission to view this resource.</p>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div style="padding: 4rem 2rem; text-align: center; color: var(--text-main);">
                    <h1 style="font-size: 4rem; margin-bottom: 1rem; color: var(--primary);">404</h1>
                    <p style="font-size: 1.25rem; opacity: 0.8;">Sorry, there's nothing at this address.</p>
                    <a href="/" style="display: inline-block; margin-top: 1.5rem; color: var(--primary); text-decoration: none; border-bottom: 2px solid var(--primary);">Go to Dashboard</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
