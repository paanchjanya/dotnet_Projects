@page "/approvals"
@attribute [Authorize(Roles = "Manager,Admin")]
@inject LeaveService LeaveService
@inject NavigationManager NavigationManager

<PageTitle>Pending Approvals - LeaveFlow</PageTitle>

<div class="fade-in">
    <h2 class="mb-4" style="font-weight: 700; color: var(--text-primary);">Pending Leave Approvals</h2>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-teal" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-secondary">Loading pending requests...</p>
        </div>
    }
    else
    {
        <div class="section-card">
            @if (!pendingRequests.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-patch-check-fill text-success" style="font-size: 3.5rem;"></i>
                    <p class="mt-3 text-secondary" style="font-weight: 600; font-size: 1.1rem;">All caught up!</p>
                    <p class="text-muted">There are no pending leave requests requiring your approval.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Leave Type</th>
                                <th>Requested Dates</th>
                                <th>Days</th>
                                <th>Reason</th>
                                <th>Attachment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in pendingRequests)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight: 600;">@req.Employee?.FirstName @req.Employee?.LastName</div>
                                        <div style="font-size: 0.75rem; color: var(--text-muted);">@req.Employee?.Department</div>
                                    </td>
                                    <td>
                                        <span style="font-weight: 500;">@req.LeaveType?.Name</span>
                                    </td>
                                    <td>
                                        <div style="font-size: 0.85rem; font-weight: 500;">@req.StartDate.ToShortDateString() - @req.EndDate.ToShortDateString()</div>
                                        <div style="font-size: 0.75rem; color: var(--text-muted);">Applied @req.AppliedDate.ToLocalTime().ToString("d")</div>
                                    </td>
                                    <td style="font-weight: 700;">@req.TotalDays</td>
                                    <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@req.Reason">
                                        @req.Reason
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(req.AttachmentPath))
                                        {
                                            <a href="@GetAttachmentUrl(req.AttachmentPath)" target="_blank" class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-color: var(--secondary); color: var(--secondary);">
                                                <i class="bi bi-file-earmark-pdf"></i> Download
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 0.8rem;">None</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-primary" style="padding: 0.4rem 1rem; font-size: 0.8rem; background: var(--success); border-color: var(--success);" @onclick='() => OpenActionModal(req.Id, "Approved")'>
                                                Approve
                                            </button>
                                            <button class="btn btn-secondary" style="padding: 0.4rem 1rem; font-size: 0.8rem; border-color: var(--danger); color: var(--danger);" @onclick='() => OpenActionModal(req.Id, "Rejected")'>
                                                Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@if (showActionModal)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Confirm Leave Decision</h3>
            </div>
            <div class="modal-body">
                <p>You are about to set this request status to: <strong class="@(actionType == "Approved" ? "text-success" : "text-danger")">@actionType</strong>.</p>
                
                <div class="form-group mt-3">
                    <label class="form-label" for="remarks">Manager Remarks (Optional)</label>
                    <textarea id="remarks" rows="3" class="form-control" @bind="managerRemarks" placeholder="Provide any comments or reason for your decision..."></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseActionModal">Cancel</button>
                <button class="btn btn-primary" style='background: @(actionType == "Approved" ? "var(--success)" : "var(--danger)"); border-color: @(actionType == "Approved" ? "var(--success)" : "var(--danger)"); box-shadow: 0 4px 14px @(actionType == "Approved" ? "rgba(16, 185, 129, 0.35)" : "rgba(239, 68, 68, 0.35)");' @onclick="SubmitAction">
                    Confirm Decision
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<LeaveRequestModel> pendingRequests = new();
    private bool isLoading = true;
    
    private bool showActionModal = false;
    private int activeRequestId;
    private string actionType = ""; // Approved, Rejected
    private string managerRemarks = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingRequests();
    }

    private async Task LoadPendingRequests()
    {
        isLoading = true;
        try
        {
            pendingRequests = await LeaveService.GetPendingApprovalsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetAttachmentUrl(string relativePath)
    {
        return $"http://localhost:5000{relativePath}";
    }

    private void OpenActionModal(int id, string type)
    {
        activeRequestId = id;
        actionType = type;
        managerRemarks = "";
        showActionModal = true;
    }

    private void CloseActionModal()
    {
        showActionModal = false;
    }

    private async Task SubmitAction()
    {
        showActionModal = false;
        isLoading = true;
        var success = await LeaveService.ActionRequestAsync(activeRequestId, actionType, managerRemarks);
        if (success)
        {
            await LoadPendingRequests();
        }
        else
        {
            isLoading = false;
        }
    }
}
