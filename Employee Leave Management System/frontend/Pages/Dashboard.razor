@page "/dashboard"
@attribute [Authorize]
@inject LeaveService LeaveService
@inject NavigationManager NavigationManager

<PageTitle>Dashboard - LeaveFlow</PageTitle>

<div class="fade-in">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-teal" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-secondary">Loading dashboard data...</p>
        </div>
    }
    else
    {
        <!-- Leave Balances -->
        <h2 class="mb-4" style="font-weight: 700; color: var(--text-primary);">Your Leave Balances</h2>
        <div class="dashboard-balances">
            @foreach (var balance in balances)
            {
                var cardClass = GetBalanceCardClass(balance.LeaveType?.Name);
                <div class="balance-card @cardClass">
                    <span class="balance-type">@balance.LeaveType?.Name</span>
                    <div class="balance-value-container">
                        <span class="balance-num">@balance.AvailableDays</span>
                        <span class="balance-label">days left</span>
                    </div>
                    <div class="balance-breakdown">
                        <span>Allocated: <strong>@balance.AllocatedDays</strong></span>
                        <span>Used: <strong>@balance.UsedDays</strong></span>
                        <span>Pending: <strong>@balance.PendingDays</strong></span>
                    </div>
                </div>
            }
        </div>

        <div class="dashboard-grid">
            <!-- Left Side: Recent Requests -->
            <div class="section-card">
                <div class="section-title">
                    <span>Recent Leave Requests</span>
                    <a href="apply-leave" class="btn btn-primary" style="padding: 0.5rem 1.25rem; font-size: 0.85rem;">
                        <i class="bi bi-plus-lg"></i> Apply Leave
                    </a>
                </div>

                @if (!requests.Any())
                {
                    <div class="text-center py-5" style="background-color: var(--background); border-radius: var(--radius); border: 1px solid var(--border);">
                        <i class="bi bi-calendar-x" style="font-size: 2.5rem; color: var(--text-muted);"></i>
                        <p class="mt-3 text-secondary" style="font-weight: 500;">You haven't submitted any leave requests yet.</p>
                        <a href="apply-leave" class="btn btn-secondary mt-3">Apply Now</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Leave Type</th>
                                    <th>Dates</th>
                                    <th>Days</th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in requests)
                                {
                                    <tr>
                                        <td>
                                            <span style="font-weight: 600;">@req.LeaveType?.Name</span>
                                            @if (!string.IsNullOrEmpty(req.AttachmentPath))
                                            {
                                                <br />
                                                <a href="@GetAttachmentUrl(req.AttachmentPath)" target="_blank" style="font-size: 0.75rem; color: var(--secondary); text-decoration: none;">
                                                    <i class="bi bi-paperclip"></i> View Attachment
                                                </a>
                                            }
                                        </td>
                                        <td>
                                            <div style="font-size: 0.85rem; font-weight: 500;">@req.StartDate.ToShortDateString() - @req.EndDate.ToShortDateString()</div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">Applied @req.AppliedDate.ToLocalTime().ToString("d")</div>
                                        </td>
                                        <td style="font-weight: 700;">@req.TotalDays</td>
                                        <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @req.Reason
                                        </td>
                                        <td>
                                            <span class="status-badge @req.Status.ToLower()">
                                                @req.Status
                                            </span>
                                        </td>
                                        <td>
                                            @if (req.Status == "Pending")
                                            {
                                                <button class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-color: var(--danger); color: var(--danger);" @onclick="() => ConfirmCancel(req.Id)">
                                                    Cancel
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted" style="font-size: 0.8rem;">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Right Side: Info Panel & Quick Links -->
            <div>
                <!-- Simulated Outbound Email logs -->
                <div class="section-card" style="background: linear-gradient(135deg, rgba(20, 184, 166, 0.03) 0%, rgba(2, 132, 199, 0.03) 100%);">
                    <h3 class="section-title">Workflow Information</h3>
                    <div style="display: flex; flex-direction: column; gap: 1rem; font-size: 0.9rem;">
                        <p class="text-secondary">
                            Your leave requests go directly to your designated manager for approval.
                        </p>
                        <div style="display: flex; align-items: center; gap: 0.75rem; background: var(--surface); padding: 0.75rem; border-radius: var(--radius); border: 1px solid var(--border);">
                            <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--accent);"></div>
                            <div>
                                <span style="font-weight: 600; font-size: 0.8rem; display: block;">STEP 1: SUBMISSION</span>
                                <span class="text-muted" style="font-size: 0.75rem;">Fills form, attaches files, notifies manager</span>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem; background: var(--surface); padding: 0.75rem; border-radius: var(--radius); border: 1px solid var(--border);">
                            <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--secondary);"></div>
                            <div>
                                <span style="font-weight: 600; font-size: 0.8rem; display: block;">STEP 2: REVIEW</span>
                                <span class="text-muted" style="font-size: 0.75rem;">Manager views request details and uploads</span>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem; background: var(--surface); padding: 0.75rem; border-radius: var(--radius); border: 1px solid var(--border);">
                            <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--success);"></div>
                            <div>
                                <span style="font-weight: 600; font-size: 0.8rem; display: block;">STEP 3: RESOLUTION</span>
                                <span class="text-muted" style="font-size: 0.75rem;">Approved/Rejected, balances updated</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showCancelModal)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Cancel Leave Request</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to cancel this leave request? This action cannot be undone, and the pending days will be restored to your leave balance.</p>
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseCancelModal">Close</button>
                <button class="btn btn-primary" style="background: var(--danger); box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);" @onclick="CancelRequest">Yes, Cancel Request</button>
            </div>
        </div>
    </div>
}

@code {
    private List<LeaveBalanceModel> balances = new();
    private List<LeaveRequestModel> requests = new();
    private bool isLoading = true;
    private bool showCancelModal = false;
    private int requestToCancelId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            balances = await LeaveService.GetMyBalancesAsync();
            requests = await LeaveService.GetMyRequestsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetBalanceCardClass(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "other";
        
        name = name.ToLower();
        if (name.Contains("sick")) return "sick";
        if (name.Contains("annual")) return "annual";
        if (name.Contains("casual")) return "casual";
        return "other";
    }

    private string GetAttachmentUrl(string relativePath)
    {
        return $"http://localhost:5000{relativePath}";
    }

    private void ConfirmCancel(int id)
    {
        requestToCancelId = id;
        showCancelModal = true;
    }

    private void CloseCancelModal()
    {
        showCancelModal = false;
    }

    private async Task CancelRequest()
    {
        showCancelModal = false;
        isLoading = true;
        var success = await LeaveService.CancelRequestAsync(requestToCancelId);
        if (success)
        {
            await LoadData();
        }
        else
        {
            isLoading = false;
        }
    }
}
